# Postgres connection string used by Prisma.
# Local example:      postgresql://postgres:postgres@localhost:5432/littlelamp
# Managed (Neon/Supabase/Vercel Postgres/Railway): copy their connection string here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/littlelamp"

# Optional: email notifications on new leads (see src/lib/notify.ts). Leave unset to just log.
RESEND_API_KEY=""

